+def _clean_zero_columns(S, vt, s_full, varying_names):
+    """v003b (Claude4 0475 R1 SF-2): clean the right vectors on EXACTLY-zero columns of the scaled Jacobian.
+
+    For each column j with S[:, j] == 0 exactly (ascending j), the right vector with the largest |vt[k, j]| not
+    already chosen for an earlier column (lowest k on ties) becomes +e_j; every other right vector gets 0 on all such
+    columns and is renormalised. Exact arithmetic gives these values (e_j is in the null space and every vector of
+    the row space has 0 there); the SVD leaves rounding-level components that _edge_t / the LP rows read as box
+    exits. When more than one vector carried a column (a shared null block), the remaining carriers are
+    re-orthonormalised (modified Gram-Schmidt, two passes, index order) against every other vector. The cleaned
+    basis must pass the _check_identifiability tolerances (orthonormal to _ORTHO_TOL, ||S v_k|| = s_k to
+    _ORTHO_TOL * max(1, s_max)); otherwise vt is returned unchanged. Returns (vt, note or None)."""
+    m, n = S.shape
+    if m == 0 or n == 0:
+        return vt, None
+    cols = [j for j in range(n) if bool(np.all(S[:, j] == 0.0))]
+    if not cols:
+        return vt, None
+    V0 = np.array(vt, dtype=float, copy=True)
+    chosen = {}
+    for j in cols:
+        cand = [k for k in range(n) if k not in chosen.values()]
+        if not cand:
+            break
+        mag = np.abs(V0[cand, j])
+        chosen[j] = cand[int(np.argmax(mag))]
+    if len(chosen) != len(cols):
+        return vt, (f'NOTE (v003b SF-2): {len(cols)} exactly-zero scaled-Jacobian columns exceed the basis; right '
+                    f'vectors not cleaned')
+    kset = set(chosen.values())
+    V = V0.copy()
+    removed = 0.0
+    for k in range(n):
+        if k in kset:
+            continue
+        removed = max(removed, float(np.max(np.abs(V[k, cols]))))
+        V[k, cols] = 0.0
+        nrm = float(np.linalg.norm(V[k]))
+        if nrm > 0.0:
+            V[k] = V[k] / nrm
+    for j, k in chosen.items():
+        V[k] = 0.0
+        V[k, j] = 1.0
+    s_max = float(s_full[0]) if n else 0.0
+
+    def passes(W):
+        if float(np.max(np.abs(W @ W.T - np.eye(n)))) > _ORTHO_TOL:
+            return False
+        return all(abs(float(np.linalg.norm(S @ W[k])) - float(s_full[k])) <= _ORTHO_TOL * max(1.0, s_max)
+                   for k in range(n))
+
+    regs = ''
+    if not passes(V):
+        carriers = [k for k in range(n) if k not in kset and float(np.max(np.abs(V0[k, cols]))) > math.sqrt(_ORTHO_TOL)]
+        if carriers:
+            others = [k for k in range(n) if k not in carriers]
+            for _pass in range(2):
+                done = []
+                for k in carriers:
+                    v = V[k].copy()
+                    for b in others + done:
+                        v = v - float(v @ V[b]) * V[b]
+                    v[cols] = 0.0
+                    nrm = float(np.linalg.norm(v))
+                    if nrm > 0.0:
+                        v = v / nrm
+                    V[k] = v
+                    done.append(k)
+            regs = f'; carrier vector(s) {carriers} re-orthonormalised'
+        if not passes(V):
+            return vt, (f'NOTE (v003b SF-2): exactly-zero scaled-Jacobian column(s) {cols} '
+                        f'({[varying_names[j] for j in cols]}): the cleaned basis fails the orthonormality / '
+                        f'singular-value tolerance; right vectors kept uncleaned (largest component on those columns '
+                        f'outside the chosen vectors {removed:.3e})')
+    V = _fix_signs(V)
+    note = (f'NOTE (v003b SF-2): exactly-zero scaled-Jacobian column(s) {cols} '
+            f'({[varying_names[j] for j in cols]}): right vector(s) {[chosen[j] for j in cols]} set to +e_j; '
+            f'components up to {removed:.3e} on those columns removed from the other right vectors, renormalised'
+            f'{regs}')
+    return V, note
+
