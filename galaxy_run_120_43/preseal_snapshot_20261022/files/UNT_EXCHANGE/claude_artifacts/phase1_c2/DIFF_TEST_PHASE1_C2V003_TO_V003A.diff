+def t43_v003_and_scope(S):
+    """v003 untouched; at1 custody accepts only a v003a-written L1; the AST scope against v003."""
+    import ast
+    check('T43.v003_tool_tests_mutation_README_and_HASHES_untouched (sha256 from bytes)',
