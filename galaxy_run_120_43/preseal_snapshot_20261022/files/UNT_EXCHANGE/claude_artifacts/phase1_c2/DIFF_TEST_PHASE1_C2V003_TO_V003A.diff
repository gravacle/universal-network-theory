+          {os.path.basename(str(p)): sha(p)[:16] for p, _h in ((V003[0], None),) + V003_FILES})
+    fx = fx_of(S, 'seed')
+    l13 = RUN / 'L1_C1.V003_SHADOW' / 'L1_C2V001.json'
+    rc, o, _d = at1_cli(fx, l13, RUN / 'AT0B_C1' / 'AT0B_C2V001.json', FIX / 'MEMBERS_C1.json', 'A149_V003_L1')
