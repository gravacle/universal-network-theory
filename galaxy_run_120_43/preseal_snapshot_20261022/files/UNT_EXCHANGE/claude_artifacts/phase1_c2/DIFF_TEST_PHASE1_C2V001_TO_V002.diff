+                                                    for j in range(43)]}}
+    pts = [{'log_index': 8, 'u': u, 'prediction': {'speeds_km_s': {rr: float(x) for rr, x in zip(L['rows'], L['fA'])}}}]
+    f2, r2 = P.at1_rows(E, L, {'rows': rows2, 'fd_du': [f['du'] for f in fd['F']]},
