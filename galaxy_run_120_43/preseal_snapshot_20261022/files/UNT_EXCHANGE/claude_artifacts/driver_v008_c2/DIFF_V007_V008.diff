+def _write_bytes_x(ctx, path, raw):
+    if ctx.mode == 'run':
+        with open(path, 'xb') as f:
+            f.write(raw)
+            f.flush()
+            os.fsync(f.fileno())
+    else:
+        if Path(path).exists():
+            raise Refusal('dry-run input exists: %s' % path)
+        Path(path).write_bytes(raw)
+    return sha256_file(path)
+
