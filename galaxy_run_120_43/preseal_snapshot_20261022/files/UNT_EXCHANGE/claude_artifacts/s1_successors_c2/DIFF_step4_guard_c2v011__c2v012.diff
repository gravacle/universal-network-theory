+def core_priority_admission(plan,cfg):
+    """guard011 L333 for every admission whose core_priority is the inactive dict (returns None: unchanged path).
+    Otherwise only the S1 overlap form passes: POST_S1, one S1 call, tail ON on r5, the plan's fill record equal to
+    the admission's, and the call's spec equal to the replay of that fill record by the admitted replay module."""
+    cp=cfg.get('core_priority')
+    if cp==CORE_PRIORITY_INACTIVE:return None
+    require(cp==CORE_PRIORITY_S1_OVERLAP and plan.get('batch')=='POST_S1','CORE_PRIORITY_ATTESTATION_REQUIRED')
+    ov=cfg.get('s1_overlap')
+    require(isinstance(ov,dict),'S1_OVERLAP_ADMISSION_REQUIRED')
+    require(set(ov)=={'schema','replay_module','fill_record'} and ov.get('schema')==S1_OVERLAP_SCHEMA,'S1_OVERLAP_ADMISSION_SCHEMA')
+    calls=plan.get('calls')
+    require(isinstance(calls,list) and len(calls)==1 and isinstance(calls[0],dict),'S1_OVERLAP_ONE_CALL_REQUIRED')
+    call=calls[0]
+    require(call.get('case') in S1_OVERLAP_CASES,'S1_OVERLAP_S1_CASE_REQUIRED')
+    require(call.get('tail_on') is True and isinstance(call.get('driver'),dict) and call['driver'].get('sha256')==R5_SHA,'S1_OVERLAP_TAIL_ON_R5_REQUIRED')
+    require(isinstance(plan.get('s1'),dict) and plan['s1'].get('fill_record')==ov['fill_record'],'S1_OVERLAP_FILL_RECORD_BINDING')
+    verify(ov['fill_record'])
+    m=load(ov['replay_module'],cfg,'_step4_s1_replay')
+    require(getattr(m,'S1_REPLAY_API',None)==S1_REPLAY_API,'S1_OVERLAP_REPLAY_API')
+    try:rep=m.guard_replay(ov['fill_record'])
+    except Exception as e:raise Refusal('S1_OVERLAP_REPLAY_REFUSED',str(getattr(e,'code',None) or type(e).__name__)) from e
+    got=(rep.get('cases') or {}).get(call['case']) if isinstance(rep,dict) else None
+    require(isinstance(got,dict) and got.get('spec')==call.get('spec'),'S1_OVERLAP_SPEC_NOT_FILLED_SPEC')
+    require(got.get('bytes')==verify(call['spec']),'S1_OVERLAP_REPLAY_MISMATCH')
+    return call
+
+def s1_overlap_started(call):
+    """True once any output of the S1 call exists (the launcher refuses to start a call whose outputs exist)."""
+    return any(os.path.lexists(p) for p in (call['outdir'],call['receipt'],call['receipt']+'.launch.json',call['monitor_log']))
+
+def load_gate():
+    m=types.ModuleType('_step4_s1_overlap_gate');m.__file__=GATE_PIN['path']
+    exec(compile(verify(GATE_PIN),GATE_PIN['path'],'exec'),m.__dict__)
+    return m
+
+def s1_overlap_live(call,*,gate=None,sleep=None):
+    """The live admission of the S1 head, before its start: gate v003 hold_check, warm-up, decide (owned = {}),
+    then the r5 route-A allowance and A133's root rule on the decide snapshot. Any gate error refuses."""
+    try:
+        GM=load_gate();M=gate if gate is not None else GM.Gate()
+        h=M.hold_check()
+        require(h.get('probe_ok') is True,'S1_OVERLAP_GATE_PROBE_FAILED')
+        require(h.get('hold') is False,'S1_OVERLAP_GATE_TWIN_HOLD')
+        M.sample(force=True);(sleep or time.sleep)(M.P['warmup_s'])
+        head=dict(GM.class_from_spec_bytes(verify(call['spec'])),name='S1_OVERLAP_HEAD_'+call['case'])
+        d=M.decide(owned={},head=head,n_running=0,max_concurrent=1)
+        require(d.get('admit') is True,'S1_OVERLAP_GATE_REFUSED')
+        snap=M.last or {}
+        runs=snap.get('runs') or []
+        view,_=M.runs_view(snap,{})
+        phase={r['key']:r['phase'] for r in view}
+        others=[r for r in runs if r.get('outdir')!=call['outdir'] and r.get('driver_sha256') in (R5_SHA,None) and phase.get(r.get('monitor_pid'))=='route_a']
+        require(len(others)<=int(M.P['route_a_cap'])-1,'S1_OVERLAP_R5_ROUTE_A_BEYOND_GATE_ALLOWANCE')
+        fp=[r.get('footprint_gb') for r in runs]
+        require(all(type(x) in (int,float) and math.isfinite(x) for x in fp),'S1_OVERLAP_A133_FOOTPRINT_UNKNOWN')
+        require(sum(fp)+A133_S1_TERM_GB+A133_CAMPAIGN_RESERVE_GB<=A133_LIMIT_GB,'S1_OVERLAP_A133_MEMORY_RULE')
+        return {'admit':True,'mem_after_admit_gb':d.get('mem_after_admit_gb'),'other_r5_route_a':len(others),'run_footprint_gb':sum(fp)}
+    except Refusal:raise
+    except Exception as e:raise Refusal('S1_OVERLAP_GATE_ERROR',type(e).__name__+': '+str(e)[:300]) from e
+
