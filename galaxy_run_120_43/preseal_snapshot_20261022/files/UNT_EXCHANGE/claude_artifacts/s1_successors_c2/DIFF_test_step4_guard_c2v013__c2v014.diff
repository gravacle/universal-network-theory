+    ok = (r['rc'] == 0 and r['started'] == ['CASE_0', 'CASE_1'] and ('CASE_1', False, False) in d
+          and d.index(('CASE_1', False, False)) < d.index(('CASE_1', True, True)) and r['audit_process_events'] == [])
+    return ok, {'decisions': d, 'started': r['started'], 'rc': r['rc']}
