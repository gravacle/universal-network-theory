+def campaign_route_a_trees(ps_text, own_outdir):
+    """Note 2 (c2v002b): the root-monitor run trees of the process table that may be campaign / step-2 calls: a command
+    line matching root_monitor_c2v<N>.py and carrying --driver (gate v003 L450), driver r5 or an unparsed driver (fail
+    closed), not this call's outdir, still in route A by route_a_done on <outdir>/progress.jsonl (an unparsed outdir
+    counts as route A). The same membership c2v002a's snapshot_r5_route_a took from the gate's snapshot."""
+    out = []
+    for ln in ps_text.splitlines():
+        f = ln.split(None, 1)
+        if len(f) < 2:
+            continue
+        try:
+            pid = int(f[0])
+        except ValueError:
+            continue
+        cmd = f[1]
+        if not (MONITOR_PATTERN.search(cmd) and '--driver' in cmd):
+            continue
+        m = _OUTDIR_RE.search(cmd)
+        outdir = m.group(1) if m else None
+        d = _DRIVER_SHA_RE.search(cmd)
+        drv = d.group(1) if d else None
+        if outdir == own_outdir or drv not in (R5_SHA, None):
+            continue
+        if outdir and route_a_done(Path(outdir) / 'progress.jsonl'):
+            continue
+        out.append({'monitor_pid': pid, 'outdir': outdir, 'driver_sha256': drv})
+    return out
 
 
