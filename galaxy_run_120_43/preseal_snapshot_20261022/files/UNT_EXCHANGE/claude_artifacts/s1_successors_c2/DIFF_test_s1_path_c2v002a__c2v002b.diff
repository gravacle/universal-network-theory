+class _FakeRun:
+    """Stands in for subprocess.run while L._process_table runs (it imports subprocess at call time); records argv."""
+    def __init__(self, rc=0, text='', exc=None):
+        self.rc, self.text, self.exc, self.argv = rc, text, exc, []
+
+    def __call__(self, argv, **kw):
+        self.argv.append(list(argv))
+        if self.exc is not None:
+            raise self.exc
+        return subprocess.CompletedProcess(argv, self.rc, self.text, '')
+
