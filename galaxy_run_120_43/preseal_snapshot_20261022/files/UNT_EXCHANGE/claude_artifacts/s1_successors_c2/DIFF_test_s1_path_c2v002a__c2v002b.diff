+def _stmt_names(node):
+    if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
+        return [node.name]
+    if isinstance(node, ast.Assign):
+        return [t.id for t in node.targets if isinstance(t, ast.Name)]
+    return []
+
+
+def _toplevel(text):
+    """name -> ast dump of each named top-level statement; plus the unnamed statements (imports, docstring) in order."""
+    named, other = {}, []
+    for n in ast.parse(text).body:
+        ks = _stmt_names(n)
+        if ks:
+            for k in ks:
+                named[k] = ast.dump(n)
+        else:
+            other.append(ast.dump(n))
+    return named, other
+
