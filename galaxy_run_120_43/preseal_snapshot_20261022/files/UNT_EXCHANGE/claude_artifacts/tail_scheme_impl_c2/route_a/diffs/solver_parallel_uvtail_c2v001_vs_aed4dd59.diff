+def _register_modules(entries):
+    """UVTAIL: load each pinned (name, path, sha256) file module and register it in sys.modules under name, so the
+    classes of shipped instances (TailBoundary, TailState) unpickle by reference. sha256 from bytes; a different file
+    already registered under the name is a conflict."""
+    for name,path,sha256 in entries:
+        data,actual=_file_bytes_sha256(path)
+        if actual!=sha256: raise ColumnPoolError('WORKER_MODULE_PIN_MISMATCH '+path)
+        have=sys.modules.get(name)
+        if have is not None:
+            if os.path.realpath(getattr(have,'__file__','') or '')!=os.path.realpath(path):
+                raise ColumnPoolError('WORKER_MODULE_REGISTRY_CONFLICT '+name)
+            continue
+        module=types.ModuleType(name)
+        module.__file__=path
+        module.__spec__=importlib.util.spec_from_file_location(name,path)
+        module.__loader__=module.__spec__.loader
+        sys.modules[name]=module
+        try: exec(compile(data,path,'exec',dont_inherit=True),module.__dict__)
+        except BaseException:
+            sys.modules.pop(name,None); raise
