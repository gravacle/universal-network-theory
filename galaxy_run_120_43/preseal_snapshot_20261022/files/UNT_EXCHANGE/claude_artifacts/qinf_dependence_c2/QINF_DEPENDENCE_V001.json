 "question": "Is the audit Qinf = 8.059986 (T5) a parameter-free constant, or a function of the calibration coordinates?",
 "verdict": {
  "status": "TESTED",
  "result": "Qinf is NOT parameter-free. It is a function of the calibration coordinates.",
  "functional_form": "Qinf = c^4/(16 pi G gamma_eff), gamma_eff = s * (gamma/Eref) * Eref_base, Eref_base = 1.4642919592009638e58 J",
  "anchor": "Qinf(limit) = 2.4077269433612114e42 / 2.9863917119177204e41 = 8.062328; T5 median over 1<=|k|<2/kpc = 8.059986 (finite-k deficit 2.9e-4)",
  "independent_of": [
   "ell_F (limit only; finite-k approach depends on it)",
   "coefficient grid (A2, V004, worm, birthk give identical limits to 1e-15)",
   "Cbar, mubar"
  ],
  "in_calibration_box": "gamma_eff spans [1.4932e40, 5.9728e42] over the s x gamma/Eref box => Qinf in [0.4031, 161.25]",
  "along_seed_curve": "factors 1..100: gamma_eff 2.8185e41..3.0051e41 (the seed rule fixes s*gamma near 3e41), so Qinf 8.54..8.01; this is why ~8 recurs"
 },
 "analytic": {
  "statement": "K_density(k) = (s Eref_base / v) J^T Gamma[F(k)] J + s gamma_GE k^2 E_hat(k_hat); F(k) is a convex combination of the 64 grid blocks (bounded); E_hat has rank 4, its null space has zero lapse component, so -[K_density^-1]_nn -> -[pinv E_hat]_nn/(gamma_eff k^2) with [pinv E_hat]_nn = -1/4 exactly, giving Q -> c^4/(16 pi G gamma_eff). s multiplies the whole kernel, so Q(k) is proportional to 1/s at every k.",
  "lines": {
   "complex_binding_v002": "L81-86 Gamma from F; L93 native=Eref*(J^T Gamma J + contact); L94-96 EH with gamma, ell_F, measure 1/4; L97-101 total/volume; L125 x=solve(K,-f)",
   "static_binding_v002": "L187 k_phys=Cbar^-1/2 k_reg/ell_F; L192 volume=ell_F^3*(1/4)*sqrt(det Cbar); L194 tensors[0]=0 (lapse); L196-203 kernel=gamma*volume*value, value quadratic in k, lapse row n*(k2 tr t - k.t.k)",
   "cardinal_v001": "L83-100 nonnegative Dirichlet-squared weights, partition of unity, periodic in k_primitive; L132 F=sum w*grid",
   "driver_mapping": "coordinate spec V001 call_spec_mapping: gamma = gamma_over_Eref*Eref_base_J; driver c2v001:556-557 Eref_eff=s*Eref, gamma_eff=s*gamma (lwr_common_v001 L26-27, checked bitwise)"
  },
  "finite_k": "Q(k)/Qinf = 1 - O(Eref_eff/(gamma_eff ell_F^3 k^2)) with grid/direction-dependent coefficient: deficit at 0.3/kpc scales x10 when gamma/Eref drops x10 and x~7.8 when ell_F halves (TESTED on the points below)"
 },
