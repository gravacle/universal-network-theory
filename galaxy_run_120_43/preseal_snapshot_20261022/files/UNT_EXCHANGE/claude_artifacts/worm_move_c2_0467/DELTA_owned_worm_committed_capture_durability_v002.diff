+def census(labels, dstar):
+    """(active slots, U, degree histogram, occupied edges, present vertices) of one labelled dwell."""
+    deg = {}
+    for e in labels['edges']:
+        for v in e:
+            deg.setdefault(v, 0)
+    occupied = tuple(labels['occupied'])
+    for a, b in occupied:
+        if a not in deg or b not in deg:
+            raise ValueError('Occupied edge outside the labelled graph')
+        deg[a] += 1
+        deg[b] += 1
+    hist = [0] * 5
+    for d in deg.values():
+        if d > 4:
+            raise ValueError('Occupied degree above four')
+        hist[d] += 1
+    U = float(sum((d - dstar) ** 2 for d in deg.values()))
+    return len(tuple(labels['slots'])), U, hist, len(occupied), len(deg)
