+def key_text_sha256(key):
+    return hashlib.sha256(','.join(format(int(v), 'x') for v in key).encode('ascii')).digest()
+
+
+def encode_keys(keys):
+    """Exact fixed-width little-endian packing of a list of seven-int keys."""
+    nbytes = np.array([[max(1, (int(v).bit_length() + 7) // 8) for v in k] for k in keys], dtype=np.int64)
+    width = int(nbytes.max()) if len(keys) else 1
+    out = np.zeros((len(keys), 7, width), dtype=np.uint8)
+    for r, k in enumerate(keys):
+        for f, v in enumerate(k):
+            b = int(v).to_bytes(int(nbytes[r, f]), 'little')
+            out[r, f, :len(b)] = np.frombuffer(b, dtype=np.uint8)
+    sha = np.array([np.frombuffer(key_text_sha256(k), dtype=np.uint8) for k in keys], dtype=np.uint8)
+    return out, nbytes, sha.reshape(len(keys), 32)
+
+
+def decode_keys(key_bytes, nbytes):
+    return [tuple(int.from_bytes(bytes(key_bytes[r, f, :int(nbytes[r, f])]), 'little') for f in range(7))
+            for r in range(key_bytes.shape[0])]
+
